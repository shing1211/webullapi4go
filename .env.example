# Template for the local credential file the live-probe census reads.
#
# Copy to .env and fill in the two values. `.env` is gitignored, so the copy is
# never committed. Do not commit real credentials to this file.
#
#     Copy-Item .env.example .env
#
# Values come from Webull's own published test accounts page:
#   https://developer.webull.hk/apis/docs/sdk#test-accounts
#
# The probe reads the PROCESS environment, not this file. Load it first:
#
#   Get-Content .env -Encoding UTF8 | Where-Object { $_ -match '^[A-Za-z_][A-Za-z0-9_]*=' } |
#     ForEach-Object { $n, $v = $_ -split '=', 2; Set-Item "env:$($n.Trim())" -Value $v }
#   cd examples/live-probe; go run .
#
# The value is NOT trimmed: a credential is not prose, and a leading or trailing
# character is part of it. Only the key is trimmed, and the key is a fixed
# identifier the file controls. A '#' inside a value is not a comment either.
# Comment lines are skipped whole, by the filter above, which requires the line
# to start with a letter or underscore.
#
# Optional: WEBULL_BASE_URL and WEBULL_MQTT_URL override the endpoints that
# WEBULL_REGION and WEBULL_ENVIRONMENT select. Leave them unset for the HK
# sandbox.
#
# The mutation gate is deliberately NOT represented here. The census needs
# WEBULL_TRADE_MUTATE=1 AND a sandbox base URL before it calls any endpoint
# that can place, cancel or move something, and a separately named
# WEBULL_LIVE_PROBE_MUTATE_NON_SANDBOX=1 to override the host condition. On the
# HK sandbox the 29 broker endpoints are 401/404 either way, so enabling the
# gate buys no coverage and only exposes the 5 real trading endpoints.

WEBULL_APP_KEY=your-trading-sandbox-app-key
WEBULL_APP_SECRET=your-trading-sandbox-app-secret
WEBULL_REGION=hk
WEBULL_ENVIRONMENT=sandbox
